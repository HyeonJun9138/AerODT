# Local environments and generated output
.codeboarding/
project_support/environment/
data/workspace/*
!data/workspace/.gitkeep
!data/workspace/logs/
data/workspace/logs/*
!data/workspace/logs/.gitkeep
project_support/build/
out/
digital_twin/visualization/unreal/**/Binaries/
digital_twin/visualization/unreal/**/Intermediate/
__pycache__/
*.py[cod]
*.log

# IDE and operating-system state
.idea/
.vs/
/.vscode/
.DS_Store
Thumbs.db

# External reference checkouts and original source assets are local-only.
project_support/reference/

# Runtime client log emitted by the compatibility SDK
projectairsim_client.log

# Unreal hosts and imported content are not part of the Cesium/Web distribution.
digital_twin/visualization/unreal/

# Local handoff/evaluation workspaces and archives are reproducible evidence, not source.
project_support/*_work/
project_support/*_deployment/
project_support/*_202609*/
project_support/**/*_work/
project_support/**/build/
project_support/**/test_workspace/
project_support/**/preview_workspace/
project_support/**/*.zip
project_support/**/*.tar
project_support/**/*.tar.gz

# A service key dropped at the root by hand belongs in the credential store, never in the repository.
/key.txt
/user_application/configs/web_dashboard/credentials/

# Where deliveries are dropped by hand before anything reads them: model runs,
# DEM tiles, archives. 763 MB at the time of writing. Whatever the twin actually
# uses is copied into the repository beside its manifest, so nothing here is
# ever the thing being loaded.
/임시폴더/

# Local temporary terrain source data.
/Temp/
