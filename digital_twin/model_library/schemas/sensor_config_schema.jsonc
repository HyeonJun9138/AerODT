{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aerodt://schemas/sensor-config/v1",
  "title": "AeroDT Native Sensor Configuration",
  "type": "object",
  "required": ["version", "mode", "sensors"],
  "properties": {
    "version": { "const": 1 },
    "mode": { "const": "ideal" },
    "sensors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "enabled", "sample-interval-ns", "parent-link"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "type": { "enum": ["imu", "gps", "camera-state"] },
          "enabled": { "type": "boolean" },
          "sample-interval-ns": { "type": "integer", "minimum": 1 },
          "parent-link": { "const": "Frame" },
          "origin": { "type": "object" },
          "intrinsics": { "type": "object" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
