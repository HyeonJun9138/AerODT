{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 24, "patch": 0 },
  "configurePresets": [
    {
      "name": "windows-debug",
      "displayName": "AeroDT Windows Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/project_support/build/aerodt/windows-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "AERODT_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "windows-release",
      "displayName": "AeroDT Windows Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/project_support/build/aerodt/windows-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "AERODT_BUILD_TESTS": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "windows-debug", "configurePreset": "windows-debug" },
    { "name": "windows-release", "configurePreset": "windows-release" }
  ],
  "testPresets": [
    {
      "name": "windows-debug",
      "configurePreset": "windows-debug",
      "output": { "outputOnFailure": true }
    }
  ]
}
